# Copy this file to `.env` and fill in real values before running `docker compose up`.
# `.env` itself is gitignored — never commit real secrets.

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=
# MinIO assets are proxied through nginx at /minio/
S3_PUBLIC_ENDPOINT=

# JWT
JWT_SECRET=

# Facebook / Meta OAuth (used for both Spring Security OAuth2 and Meta Graph API)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
META_REDIRECT_URI=
CONFIG_ID=

# Instagram OAuth
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Meta Marketing API (optional convenience fields)
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=

# Mail (Gmail SMTP)
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend public URL (no trailing slash)
FRONTEND_URL=

# AI Insights service (Groq-backed FastAPI assistant, see ai-service/)
AI_INSIGHTS_ENABLED=true
AI_INSIGHTS_BASE_URL=http://ai-service:8000
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=1800
GROQ_MAX_ATTEMPTS=2
USE_MOCK_LLM=false
